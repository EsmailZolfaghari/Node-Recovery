├── master/          # 3X-UI Master integration
│   └── client.py    # Master API client
├── telegram/        # Telegram bot
│   └── bot.py       # Bot implementation
├── services/        # Business logic services
│   ├── health_monitor.py    # Node health monitoring
│   └── orchestrator.py      # Replacement orchestration
├── api/             # External APIs
├── tests/           # Test suites
│   ├── unit/        # Unit tests
│   ├── integration/ # Integration tests

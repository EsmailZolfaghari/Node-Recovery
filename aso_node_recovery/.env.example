# ASO Node Recovery - Environment Configuration

# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# ===========================================
# Application Settings
# ===========================================
APP_NAME="ASO Node Recovery"
DEBUG=false

# Dry run mode - if true, no real actions are taken
DRY_RUN_ENABLED=false

# ===========================================
# Hetzner Cloud Settings
# ===========================================
HETZNER_API_TOKEN=""

# ===========================================
# Linode Settings
# ===========================================
LINODE_API_TOKEN=""

# ===========================================
# 3X-UI Master Settings
# ===========================================
MASTER_HOST="localhost"
MASTER_PORT=54321
MASTER_USERNAME="admin"
MASTER_PASSWORD=""
MASTER_USE_HTTPS=false

# ===========================================
# SSH Settings
# ===========================================
SSH_USERNAME="root"
SSH_KEY_FILE=""
# SSH_PASSWORD is only needed if not using key-based auth
SSH_PASSWORD=""
SSH_TIMEOUT=30
SSH_CONNECT_TIMEOUT=60

# ===========================================
# Reachability Check Settings
# ===========================================
REACHABILITY_PROVIDER="check-host"
CHECK_HOST_API_KEY=""
MIN_REACHABLE_COUNTRIES=3

# ===========================================
# Failure Detection Settings
# ===========================================
PING_INTERVAL_SECONDS=60
CONSECUTIVE_FAILURES_THRESHOLD=3
FAILURE_CONFIRMATION_RETRIES=2

# ===========================================
# Replacement Settings
# ===========================================
MAX_ATTEMPTS=5
IP_CHECK_MAX_RETRIES=3
SSH_READY_TIMEOUT_SECONDS=300
DEPLOYMENT_TIMEOUT_SECONDS=600
MAX_CONCURRENT_REPLACEMENTS=3

# ===========================================
# Telegram Bot Settings
# ===========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_USER_IDS=[]
TELEGRAM_NOTIFY_ON_FAILURE=true
TELEGRAM_NOTIFY_ON_REPLACEMENT_START=true
TELEGRAM_NOTIFY_ON_REPLACEMENT_COMPLETE=true
TELEGRAM_NOTIFY_ON_REPLACEMENT_FAIL=true

# ===========================================
# Database Settings
# ===========================================
DATABASE_PATH="data/aso_recovery.db"

# ===========================================
# Logging Settings
# ===========================================
LOGGING_LEVEL="INFO"
LOGGING_FORMAT_TYPE="console"
# LOGGING_FILE_PATH="logs/aso_recovery.log"
